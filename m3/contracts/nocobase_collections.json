        "id": {
          "type": "bigint",
          "nullable": false,
          "identity": true,
          "primary_key": true
        },
        "station_id": {"type": "text", "nullable": false},
        "as_of": {"type": "timestamptz", "nullable": false},
        "generated_at": {"type": "timestamptz", "nullable": false},
        "source_data_end": {"type": "timestamptz", "nullable": false},
        "status": {"type": "text", "nullable": false},
        "series_payload": {"type": "jsonb", "nullable": false},
        "model_manifest": {"type": "jsonb", "nullable": false},
        "content_hash": {"type": "text", "nullable": false},
        "updated_at": {
          "type": "timestamptz",
          "nullable": false,
          "client_writable": false,
          "server_managed": {
            "on_create": "current_timestamp",
            "on_update": "current_timestamp"
          }
        }
      },
      "unique_constraints": [
        {
          "name": "energy_forecast_latest_station_id_key",
          "fields": ["station_id"]
        }
      ],
      "foreign_keys": [],
      "indexes": [
        {
          "name": "energy_forecast_latest_station_id_key",
          "fields": ["station_id"],
          "unique": true,
          "provided_by": "unique_constraint",
          "access_pattern": {
            "equality_prefix": ["station_id"],
            "range_suffix": []
          }
        }
      ],
      "check_constraints": [
        {
          "name": "energy_forecast_latest_status_check",
          "kind": "enum",
          "field": "status",
          "allowed_values": ["ok", "warming_up", "degraded"]
        }
      ],
      "application_invariants": [
        "exactly_two_configured_series_reach_terminal_state_before_publish",
        "predictable_series_have_exactly_96_points",
        "unpredictable_series_have_empty_points_and_explicit_reason",
        "same_as_of_and_content_hash_is_idempotent",
        "same_as_of_with_different_content_hash_is_conflict",
        "publish_with_one_update_or_create_after_complete_validation"
      ]
    },
    {
      "name": "energy_forecast_batches",
      "fields": {
        "id": {
          "type": "bigint",
          "nullable": false,
          "identity": true,
          "primary_key": true
        },
        "station_id": {"type": "text", "nullable": false},
        "acceptance_run_id": {"type": "text", "nullable": false},
        "issued_at": {"type": "timestamptz", "nullable": false},
        "forecast_start_time": {"type": "timestamptz", "nullable": false},
        "forecast_end_time": {"type": "timestamptz", "nullable": false},
        "status": {"type": "text", "nullable": false},
        "write_state": {"type": "text", "nullable": false},
        "model_manifest": {"type": "jsonb", "nullable": false},
        "point_templates": {"type": "jsonb", "nullable": false},
        "content_hash": {"type": "text", "nullable": false},
        "created_at": {
          "type": "timestamptz",
          "nullable": false,
          "generated_on_create": "current_timestamp"
        }
      },
      "unique_constraints": [
        {
          "name": "energy_forecast_batches_station_run_issued_key",
          "fields": ["station_id", "acceptance_run_id", "issued_at"]
        }
      ],
      "foreign_keys": [],
      "indexes": [
        {
          "name": "energy_forecast_batches_station_run_issued_key",
          "fields": ["station_id", "acceptance_run_id", "issued_at"],
          "unique": true,
          "provided_by": "unique_constraint",
          "access_pattern": {
            "equality_prefix": ["station_id", "acceptance_run_id"],
            "range_suffix": ["issued_at"]
          }
        }
      ],
      "check_constraints": [
        {
          "name": "energy_forecast_batches_window_check",
          "kind": "field_comparison",
          "left_field": "forecast_end_time",
          "operator": ">",
          "right_field": "forecast_start_time"
        },
        {
          "name": "energy_forecast_batches_status_check",
          "kind": "enum",
          "field": "status",
          "allowed_values": ["ok", "degraded"]
        },
        {
          "name": "energy_forecast_batches_write_state_check",
          "kind": "enum",
          "field": "write_state",
          "allowed_values": ["writing", "complete"]
        }
      ],
      "application_invariants": [
        "point_templates_remain_immutable_and_contain_exactly_192_prediction_points",
        "readers_ignore_write_state_writing",
        "recovery_reuses_persisted_point_templates_without_rerunning_models",
        "no_automatic_retention_cleanup_in_initial_release"
      ]
    },
    {
      "name": "energy_forecast_points",
      "fields": {
        "id": {
          "type": "bigint",
          "nullable": false,
          "identity": true,
          "primary_key": true
        },
        "batch_id": {"type": "bigint", "nullable": false},
        "unique_id": {"type": "text", "nullable": false},
        "data_time": {"type": "timestamptz", "nullable": false},
        "target_time": {"type": "timestamptz", "nullable": false},
        "horizon_step": {"type": "smallint", "nullable": false},
        "model_name": {"type": "text", "nullable": false},
        "raw_forecast": {"type": "numeric(14,6)", "nullable": false},
        "forecast_value": {"type": "numeric(14,6)", "nullable": false},
        "is_clipped": {"type": "boolean", "nullable": false},
        "actual_value": {"type": "numeric(14,6)", "nullable": true},
        "actual_quality": {"type": "text", "nullable": true},
        "actual_source_revision": {"type": "bigint", "nullable": true},
        "actual_recorded_at": {"type": "timestamptz", "nullable": true},
        "evaluated_at": {"type": "timestamptz", "nullable": true},
        "absolute_percentage_error": {"type": "numeric(14,8)", "nullable": true}
      },
      "unique_constraints": [
        {
          "name": "energy_forecast_points_batch_unique_data_time_key",
          "fields": ["batch_id", "unique_id", "data_time"]
        }
      ],
      "foreign_keys": [
        {
          "name": "energy_forecast_points_batch_id_fkey",
          "fields": ["batch_id"],
          "references": {
            "collection": "energy_forecast_batches",
            "fields": ["id"]
          },
          "on_delete": "restrict",
          "index_coverage": "energy_forecast_points_batch_unique_data_time_key"
        }
      ],
      "indexes": [
        {
          "name": "energy_forecast_points_batch_unique_data_time_key",
          "fields": ["batch_id", "unique_id", "data_time"],
          "unique": true,
          "provided_by": "unique_constraint",
          "access_pattern": {
            "equality_prefix": ["batch_id", "unique_id"],
            "range_suffix": ["data_time"]
          }
        }
      ],
      "check_constraints": [
        {
          "name": "energy_forecast_points_target_interval_check",
          "kind": "timestamp_interval",
          "start_field": "data_time",
          "end_field": "target_time",
          "interval_minutes": 15
        },
        {
          "name": "energy_forecast_points_horizon_step_check",
          "kind": "range",
          "field": "horizon_step",
          "range": {"minimum": 1, "maximum": 96}
        },
        {
          "name": "energy_forecast_points_unique_id_check",
          "kind": "non_empty_text",
          "field": "unique_id"
        },
        {
          "name": "energy_forecast_points_load_forecast_check",
          "kind": "conditional_minimum",
          "when": {"field": "unique_id", "equals": "station_total_load"},
          "field": "forecast_value",
          "minimum": 0
        },
        {
          "name": "energy_forecast_points_soc_forecast_check",
          "kind": "conditional_range",
          "when": {"field": "unique_id", "in": ["storage_soc"]},
          "field": "forecast_value",
          "range": {"minimum": 0, "maximum": 100}
        },
        {
          "name": "energy_forecast_points_actual_quality_check",
          "kind": "enum",
          "field": "actual_quality",
          "allowed_values": ["valid", "invalid"],
          "null_allowed": true
        }
      ],
      "application_invariants": [
        "replay_compares_immutable_forecast_fields_and_never_updates_them",
        "batch_completes_only_after_192_points_and_content_hash_verify",
        "actual_value_zero_with_actual_quality_valid_remains_scoreable",
        "source_revision_must_increase_before_actual_fields_change"
      ]
    },
    {
