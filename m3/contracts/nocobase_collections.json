        "window_end": {"type": "timestamptz", "nullable": false},
        "expected_count": {"type": "smallint", "nullable": false},
        "valid_count": {"type": "smallint", "nullable": false},
        "zero_actual_count": {"type": "smallint", "nullable": false},
        "mape_percent": {"type": "numeric(10,6)", "nullable": true},
        "mae": {"type": "numeric(14,6)", "nullable": true},
        "smape_percent": {"type": "numeric(10,6)", "nullable": true},
        "wape_percent": {"type": "numeric(10,6)", "nullable": true},
        "median_ape_percent": {"type": "numeric(10,6)", "nullable": true},
        "p90_ape_percent": {"type": "numeric(10,6)", "nullable": true},
        "outcome": {"type": "text", "nullable": false},
        "calculated_at": {"type": "timestamptz", "nullable": false}
      },
      "unique_constraints": [
        {
          "name": "energy_forecast_evaluations_station_run_key",
          "fields": ["station_id", "acceptance_run_id", "evaluation_key"]
        }
      ],
      "foreign_keys": [],
      "indexes": [
        {
          "name": "energy_forecast_evaluations_station_run_key",
          "fields": ["station_id", "acceptance_run_id", "evaluation_key"],
          "unique": true,
          "provided_by": "unique_constraint",
          "access_pattern": {
            "equality_prefix": ["station_id", "acceptance_run_id", "evaluation_key"],
            "range_suffix": []
          }
        },
        {
          "name": "energy_forecast_evaluations_station_run_idx",
          "fields": ["station_id", "acceptance_run_id"],
          "unique": false,
          "provided_by": "explicit_index",
          "access_pattern": {
            "equality_prefix": ["station_id", "acceptance_run_id"],
            "range_suffix": []
          }
        }
      ],
      "check_constraints": [
        {
          "name": "energy_forecast_evaluations_key_check",
          "kind": "enum",
          "field": "evaluation_key",
          "allowed_values": ["station_total_load", "storage_soc", "overall"]
        },
        {
          "name": "energy_forecast_evaluations_window_check",
          "kind": "timestamp_interval",
          "start_field": "window_start",
          "end_field": "window_end",
          "interval_days": 7
        },
        {
          "name": "energy_forecast_evaluations_series_counts_check",
          "kind": "conditional_counts",
          "when": {"field": "evaluation_key", "in": ["station_total_load", "storage_soc"]},
          "expected_count": 672,
          "count_fields": ["valid_count", "zero_actual_count"],
          "range": {"minimum": 0, "maximum": 672}
        },
        {
          "name": "energy_forecast_evaluations_overall_counts_check",
          "kind": "conditional_counts",
          "when": {"field": "evaluation_key", "equals": "overall"},
          "expected_count": 1344,
          "count_fields": ["valid_count", "zero_actual_count"],
          "range": {"minimum": 0, "maximum": 1344}
        },
        {
          "name": "energy_forecast_evaluations_count_partition_check",
          "kind": "sum_maximum",
          "fields": ["valid_count", "zero_actual_count"],
          "maximum_field": "expected_count"
        },
        {
          "name": "energy_forecast_evaluations_mape_check",
          "kind": "nullable_minimum",
          "field": "mape_percent",
          "minimum": 0
        },
        {
          "name": "energy_forecast_evaluations_overall_metrics_check",
          "kind": "conditional_null",
          "when": {"field": "evaluation_key", "equals": "overall"},
          "fields": [
            "mape_percent",
            "mae",
            "smape_percent",
            "wape_percent",
            "median_ape_percent",
            "p90_ape_percent"
          ]
        },
        {
          "name": "energy_forecast_evaluations_outcome_check",
          "kind": "enum",
          "field": "outcome",
          "allowed_values": ["in_progress", "passed", "failed", "insufficient_data"]
        }
      ],
      "application_invariants": [
        "upsert_changes_only_evaluation_fields",
        "overall_row_stores_only_the_two_series_combined_outcome",
        "each_acceptance_run_has_at_most_two_series_rows_and_one_overall_row"
      ]
    }
