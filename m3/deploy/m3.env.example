# Worker 私有配置。复制到 /etc/vifa-m3/m3.env 后替换全部 REPLACE_ 值。
M3_STATIONS_JSON='[{"station_id":"REPLACE_FULL_ES01","station_key":"station_1","station_name":"1# 电站"},{"station_id":"REPLACE_FULL_ES02","station_key":"station_2","station_name":"2# 电站"}]'
M3_RAW_SOURCE_URL=https://vifa.hlszh.com/api/t_es_data:list
M3_RAW_SOURCE_API_TOKEN_FILE=/run/secrets/raw-source.token
M3_SOURCE_BASE_URL=https://vifa.hlszh.com
M3_SOURCE_API_TOKEN=REPLACE_SOURCE_API_TOKEN
M3_NOCOBASE_BASE_URL=https://vifa.hlszh.com
M3_NOCOBASE_API_KEY=REPLACE_WORKER_WRITE_API_KEY
M3_ADMIN_API_TOKEN=REPLACE_WORKER_ADMIN_API_TOKEN
M3_ACCEPTANCE_ENABLED=false
M3_TIMEZONE=Asia/Shanghai

# 自定义/每日预测允许的输出粒度（秒）；未设置时保持全部六种粒度。
# 六种粒度均启用；如临时限制，配置相应秒数列表。历史结果始终可读取。
#M3_CUSTOM_FORECAST_INTERVALS=30,60,300,900,1800,3600

# 常规排班 API + NocoBase 临时加班表；默认启用，使用服务端内置密钥。
M3_PRODUCTION_SCHEDULE_ENABLED=true
# 如需覆盖，设置 M3_PRODUCTION_SCHEDULE_API_KEY 或 M3_PRODUCTION_SCHEDULE_API_KEY_FILE，不能同时设置。

# 原始采样本地滚动缓存目录（可选）。设置后 Worker 把 t_es_data 原始行缓存在
# 该目录的 SQLite 中，预测任务只增量拉取缺失尾部（重叠回拉48小时捕获迟到/修订），
# 滚动只保留90天；不设置则保持每任务全量拉取。目录必须在容器挂载卷上以持久化。
#M3_RAW_HISTORY_CACHE_DIR=/run/vifa-m3/cache
