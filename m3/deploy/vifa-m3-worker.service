[Unit]
Description=VIFA M3 two-station forecast worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vifa-m3
Group=vifa-m3
WorkingDirectory=/userdata/holo/pyfiles/vifa-m3
EnvironmentFile=/etc/vifa-m3/m3.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NUMBA_CACHE_DIR=/userdata/holo/pyfiles/vifa-m3/cache/numba
ExecStart=/userdata/holo/pyfiles/vifa-m3/m3/deploy/host-entrypoint.sh worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/userdata/holo/pyfiles/vifa-m3/run /userdata/holo/pyfiles/vifa-m3/cache

[Install]
WantedBy=multi-user.target
