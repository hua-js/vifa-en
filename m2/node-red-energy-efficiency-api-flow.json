    "type": "function",
    "z": "b9c07ab9fb24cf5f",
    "g": "6a0f5b7f19c0f860",
    "name": "脱敏分钟写入结果",
    "func": "try {\n    const output = String(msg.payload || '').trim();\n    if (!output || /[\\r\\n]/.test(output)) {\n        throw new Error('not one JSON line');\n    }\n    const result = JSON.parse(output);\n    const data = result && result.data;\n    if (!data || !['ok', 'partial'].includes(result.status) || data.operation !== 'minute' || !['ES01', 'ES02'].includes(data.station_id)) {\n        throw new Error('not a minute result');\n    }\n    msg.payload = {\n        status: result.status,\n        operation: 'minute',\n        station_id: data.station_id,\n        data_time: data.data_time || null,\n        device_points_saved: Number(data.device_points_saved || 0),\n        event_update_count: Number(data.event_update_count || 0),\n        warning_count: Number(data.warning_count || 0)\n    };\n    return [msg, null];\n} catch (error) {\n    return [null, { ...msg, payload: { status: 'error', source: 'minute_job', message: '分钟任务没有返回可用结果' } }];\n}",
    "outputs": 2,
