    "name": "包装JSON结果",
    "func": "try {\n    const output = String(msg.payload || '').trim();\n    const result = JSON.parse(output);\n\n    msg.statusCode = result.status === 'ok' ? 200 : 502;\n    msg.payload = result;\n} catch (error) {\n    msg.statusCode = 500;\n    msg.payload = {\n        status: 'error',\n        error: {\n            message: 'Python 没有返回正确的 JSON'\n        }\n    };\n}\n\nmsg.headers = {\n    'Content-Type': 'application/json; charset=utf-8'\n};\n\nreturn msg;",
