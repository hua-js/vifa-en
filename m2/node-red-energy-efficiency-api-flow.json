    "name": "检查场站",
    "func": "const query = msg.req.query || {};\nconst stationId = String(query.station_id || 'ES02').trim().toUpperCase();\n\nif (!['ES01', 'ES02'].includes(stationId)) {\n    msg.statusCode = 400;\n    msg.headers = { 'Content-Type': 'application/json; charset=utf-8' };\n    msg.payload = {\n        status: 'error',\n        error: {\n            message: 'station_id 只能是 ES01 或 ES02'\n        }\n    };\n    return [null, msg];\n}\n\nmsg.payload = stationId;\nreturn [msg, null];",
    "outputs": 2,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
