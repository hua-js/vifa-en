# Set these in the existing Node-RED process/container environment, then restart it.
# Do not import the real Token into the Flow JSON or HTML.
M4_IFRAME_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS
M4_PUBLIC_ORIGIN=https://opdash.lvkpower.com
M4_FRAME_ORIGIN=https://ems.lvkpower.com
# Native host Node-RED: localhost and M4_BIND_PORT.
# Container Node-RED: http://m4-api:8844 on the shared Docker network.
M4_BACKEND_URL=http://127.0.0.1:8844
