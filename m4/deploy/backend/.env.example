# Non-sensitive deployment settings only. Do not put NocoBase tokens here.
# Set a unique instance name, data volume and port for each project on the same host.
M4_INSTANCE_NAME=vifa-m4
# Use a unique alias on a shared network and match Node-RED M4_BACKEND_URL.
M4_BACKEND_ALIAS=m4-api
M4_BIND_PORT=8844
M4_IMAGE=ccr.ccs.tencentyun.com/taidai-holobase-168/vifa-m4:0.1.0
M4_DATA_VOLUME=vifa-m4-data
M4_PLATFORM=linux/amd64
VIFA_PROJECT_CONFIG_HOST=../config/project.json
# Enable only after validating project settings and stopping the old scheduler.
M4_AUTO_PLAN_ENABLED=0
M4_SHARED_NETWORK=1panel-network
